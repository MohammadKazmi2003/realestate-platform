{
  "index_patterns": [
    "properties_v*"
  ],
  "priority": 100,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "30s",
      "analysis": {
        "filter": {
          "synonym_filter": {
            "type": "synonym",
            "synonyms_path": "analysis/synonyms.txt",
            "updateable": true
          },
          "edge_ngram_filter": {
            "type": "edge_ngram",
            "min_gram": 2,
            "max_gram": 20
          },
          "english_stemmer": {
            "type": "stemmer",
            "language": "english"
          }
        },
        "analyzer": {
          "autocomplete_analyzer": {
            "type": "custom",
            "tokenizer": "standard",
            "filter": [
              "lowercase",
              "edge_ngram_filter"
            ]
          },
          "autocomplete_search_analyzer": {
            "type": "custom",
            "tokenizer": "standard",
            "filter": [
              "lowercase"
            ]
          },
          "property_index_analyzer": {
            "type": "custom",
            "tokenizer": "standard",
            "filter": [
              "lowercase",
              "english_stemmer"
            ]
          },
          "property_search_analyzer": {
            "type": "custom",
            "tokenizer": "standard",
            "filter": [
              "lowercase",
              "synonym_filter",
              "english_stemmer"
            ]
          }
        }
      }
    },
    "mappings": {
      "dynamic": false,
      "properties": {
        "id": {
          "type": "keyword"
        },
        "title": {
          "type": "text",
          "analyzer": "property_index_analyzer",
          "search_analyzer": "property_search_analyzer"
        },
        "description": {
          "type": "text",
          "analyzer": "property_index_analyzer",
          "search_analyzer": "property_search_analyzer"
        },
        "location_text": {
          "type": "text",
          "analyzer": "property_index_analyzer",
          "fields": {
            "autocomplete": {
              "type": "text",
              "analyzer": "autocomplete_analyzer",
              "search_analyzer": "autocomplete_search_analyzer"
            }
          },
          "search_analyzer": "property_search_analyzer"
        },
        "location": {
          "type": "geo_point"
        },
        "price": {
          "type": "scaled_float",
          "scaling_factor": 100
        },
        "property_type": {
          "type": "keyword"
        },
        "property_type_id": {
          "type": "integer"
        },
        "listing_purpose": {
          "type": "keyword"
        },
        "listing_purpose_id": {
          "type": "integer"
        },
        "availability_status": {
          "type": "keyword"
        },
        "ownership_type": {
          "type": "keyword"
        },
        "bhk_type": {
          "type": "keyword"
        },
        "bhk_type_id": {
          "type": "integer"
        },
        "bedrooms": {
          "type": "integer"
        },
        "bathrooms": {
          "type": "integer"
        },
        "balconies": {
          "type": "integer"
        },
        "cabins": {
          "type": "integer"
        },
        "workstations": {
          "type": "integer"
        },
        "min_seats": {
          "type": "integer"
        },
        "max_seats": {
          "type": "integer"
        },
        "area_sqft": {
          "type": "float"
        },
        "area_unit": {
          "type": "keyword"
        },
        "furnishing_status": {
          "type": "keyword"
        },
        "amenities": {
          "type": "keyword"
        },
        "furnishings": {
          "type": "keyword"
        },
        "other_rooms": {
          "type": "keyword"
        },
        "location_advantages": {
          "type": "keyword"
        },
        "is_price_negotiable": {
          "type": "boolean"
        },
        "sort_price": {
          "type": "scaled_float",
          "scaling_factor": 100
        },
        "entity_type": {
          "type": "keyword"
        },
        "status": {
          "type": "keyword"
        },
        "property_score": {
          "type": "integer"
        },
        "image_url": {
          "type": "keyword",
          "index": false
        },
        "all_images": {
          "type": "keyword",
          "index": false
        },
        "owner_name": {
          "type": "text",
          "analyzer": "property_index_analyzer",
          "search_analyzer": "property_search_analyzer"
        },
        "owner_phone": {
          "type": "keyword",
          "index": false
        },
        "project_name": {
          "type": "text",
          "analyzer": "property_index_analyzer",
          "fields": {
            "keyword": {
              "type": "keyword"
            }
          },
          "search_analyzer": "property_search_analyzer"
        },
        "developer_name": {
          "type": "text",
          "analyzer": "property_index_analyzer",
          "search_analyzer": "property_search_analyzer"
        },
        "created_at": {
          "type": "date"
        },
        "updated_at": {
          "type": "date"
        }
      }
    }
  }
}
