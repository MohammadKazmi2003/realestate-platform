{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 1,
    "refresh_interval": "1s",
    "analysis": {
      "filter": {
        "synonym_filter": {
          "type": "synonym",
          "synonyms": [
            "apartment, apartments, flat, flats, condo, condos, condominium, condominiums",
            "independent house, villa, villas, bungalow, bungalows, standalone",
            "studio, studios, studio apartment, 1rk",
            "2bhk, 2 bhk, two bhk, two bedroom, 2 bedroom",
            "3bhk, 3 bhk, three bhk, three bedroom, 3 bedroom",
            "4bhk, 4 bhk, four bhk, 4 bedroom",
            "pg, paying guest, co-living, shared accommodation",
            "luxury, premium, high-end, upscale, deluxe",
            "budget, affordable, economical, low-cost",
            "near, close to, adjacent to, beside, nearby",
            "furnished, fully furnished, ready to move",
            "semi furnished, semi-furnished, partly furnished",
            "unfurnished, bare shell",
            "parking, car park, garage, vehicle parking"
          ]
        },
        "english_stemmer": { "type": "stemmer", "language": "english" },
        "edge_ngram_filter": {
          "type": "edge_ngram",
          "min_gram": 2,
          "max_gram": 20
        }
      },
      "analyzer": {
        "project_search_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "synonym_filter", "english_stemmer"]
        },
        "autocomplete_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "edge_ngram_filter"]
        },
        "autocomplete_search_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": false,
    "properties": {
      "id": { "type": "keyword" },
      "name": {
        "type": "text",
        "analyzer": "project_search_analyzer",
        "fields": {
          "keyword": { "type": "keyword" },
          "autocomplete": {
            "type": "text",
            "analyzer": "autocomplete_analyzer",
            "search_analyzer": "autocomplete_search_analyzer"
          }
        }
      },
      "slug": { "type": "keyword" },
      "description": { "type": "text", "analyzer": "project_search_analyzer" },
      "developer_name": {
        "type": "text",
        "analyzer": "project_search_analyzer",
        "fields": { "keyword": { "type": "keyword" } }
      },
      "low_price": { "type": "scaled_float", "scaling_factor": 100 },
      "high_price": { "type": "scaled_float", "scaling_factor": 100 },
      "construction_phase": { "type": "keyword" },
      "delivery_date": { "type": "date" },
      "location_text": {
        "type": "text",
        "analyzer": "project_search_analyzer",
        "fields": { "keyword": { "type": "keyword" } }
      },
      "location": { "type": "geo_point" },
      "amenities": { "type": "keyword" },
      "bedrooms": { "type": "integer" },
      "city": { "type": "keyword" },
      "sort_price": { "type": "scaled_float", "scaling_factor": 100 },
      "entity_type": { "type": "keyword" },
      "status": { "type": "keyword" },
      "image_url": { "type": "keyword", "index": false },
      "created_at": { "type": "date" },
      "suggest": { "type": "completion" },

      "description_html": { "type": "text", "index": false },
      "master_plan_description": { "type": "text", "index": false },
      "master_plan_storage_path": { "type": "keyword", "index": false },
      "brochure_storage_path": { "type": "keyword", "index": false },
      "price_currency": { "type": "keyword" },
      "latitude": { "type": "double" },
      "longitude": { "type": "double" },
      "construction_progress_percent": { "type": "integer" },
      "developer_detail": { "type": "object", "enabled": false },
      "project_media": { "type": "object", "enabled": false },
      "project_videos": { "type": "object", "enabled": false },
      "unit_configurations": { "type": "object", "enabled": false },
      "faqs": { "type": "object", "enabled": false },
      "amenities_detail": { "type": "object", "enabled": false },
      "price_range": { "type": "object", "enabled": false },
      "description_embedding": {
        "type": "dense_vector",
        "dims": 768,
        "element_type": "float",
        "index": true,
        "similarity": "cosine"
      }
    }
  }
}
