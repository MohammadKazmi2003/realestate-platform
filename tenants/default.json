{
  "$comment": "Tenant configuration — one file per country / white-label buyer. Selected at build time via NEXT_PUBLIC_TENANT (default: 'default'). Every value here replaces a former hardcoding so new markets launch without code changes. Buyer stacks are fully isolated (own DB + ES + deploy), so no tenant_id plumbing is needed.",
  "slug": "default",
  "brand": {
    "name": "Soft Homes"
  },
  "locale": "en-IN",
  "currency": "INR",
  "propertyCurrency": "INR",
  "projectCurrency": "AED",
  "moneyCompact": {
    "INR": {
      "symbol": "₹",
      "steps": [
        { "gte": 10000000, "div": 10000000, "digits": 2, "suffix": "Cr" },
        { "gte": 100000, "div": 100000, "digits": 1, "suffix": "L" }
      ]
    },
    "AED": {
      "symbol": "AED ",
      "steps": [
        { "gte": 1000000, "div": 1000000, "digits": 2, "suffix": "M" },
        { "gte": 1000, "div": 1000, "digits": 0, "suffix": "K" }
      ]
    },
    "USD": {
      "symbol": "$",
      "steps": [
        { "gte": 1000000000, "div": 1000000000, "digits": 1, "suffix": "B" },
        { "gte": 1000000, "div": 1000000, "digits": 1, "suffix": "M" },
        { "gte": 1000, "div": 1000, "digits": 0, "suffix": "K" }
      ]
    }
  },
  "bedsModel": "bhk",
  "bedsLabel": "BHK",
  "areaUnit": "sqft",
  "map": {
    "center": [77.0266, 28.4595],
    "zoom": 4,
    "geocodeCountries": ""
  },
  "features": {
    "projects": true
  },
  "filterNormalization": {
    "$comment": "Cache-key normalization: snap continuous inputs to buckets so near-identical searches share one ES query. Price snaps WIDEN (min floors, max ceils) so results stay a superset — applied to BOTH the ES query and the hash, never hash-only. Steps are per display currency; scope=both uses the finest involved step.",
    "priceSteps": { "INR": 500000, "AED": 50000, "USD": 25000 },
    "areaStep": 100,
    "radiusStep": 5,
    "arrayFields": ["amenities", "furnishings"],
    "stripFromMarkerKey": ["sort", "pageSize", "cursor"],
    "polygonMaxPoints": 50,
    "polygonPrecision": 4
  },
  "priceScales": {
    "$comment": "Zillow-style adaptive slider buckets per currency x purpose (sale|rent). tiers[] must ascend by upTo; step is the slider increment + snap granularity inside that band. min/max bound the track; max edge renders as ceilLabel (Any) and omits the ES lte. Edit JSON only — no code changes to add/modify currencies.",
    "INR": {
      "sale": {
        "min": 0,
        "max": 200000000,
        "ceilLabel": "₹20Cr+",
        "tiers": [
          { "upTo": 10000000, "step": 500000 },
          { "upTo": 50000000, "step": 1000000 },
          { "upTo": 100000000, "step": 2500000 },
          { "upTo": 200000000, "step": 5000000 }
        ]
      },
      "rent": {
        "min": 0,
        "max": 500000,
        "ceilLabel": "₹5L+",
        "tiers": [
          { "upTo": 50000, "step": 1000 },
          { "upTo": 200000, "step": 5000 },
          { "upTo": 500000, "step": 10000 }
        ]
      }
    },
    "AED": {
      "sale": {
        "min": 0,
        "max": 50000000,
        "ceilLabel": "AED 50M+",
        "tiers": [
          { "upTo": 1000000, "step": 25000 },
          { "upTo": 5000000, "step": 50000 },
          { "upTo": 20000000, "step": 250000 },
          { "upTo": 50000000, "step": 500000 }
        ]
      },
      "rent": {
        "min": 0,
        "max": 1000000,
        "ceilLabel": "AED 1M+",
        "tiers": [
          { "upTo": 100000, "step": 2000 },
          { "upTo": 500000, "step": 5000 },
          { "upTo": 1000000, "step": 10000 }
        ]
      }
    },
    "USD": {
      "sale": {
        "min": 0,
        "max": 20000000,
        "ceilLabel": "$20M+",
        "tiers": [
          { "upTo": 500000, "step": 10000 },
          { "upTo": 2000000, "step": 25000 },
          { "upTo": 10000000, "step": 100000 },
          { "upTo": 20000000, "step": 250000 }
        ]
      },
      "rent": {
        "min": 0,
        "max": 25000,
        "ceilLabel": "$25K+",
        "tiers": [
          { "upTo": 5000, "step": 100 },
          { "upTo": 25000, "step": 250 }
        ]
      }
    }
  }
}
