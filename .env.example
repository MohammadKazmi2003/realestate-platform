# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Supabase Auth — SMTP (production only, set via `supabase secrets set` or Supabase dashboard)
SMTP_HOST=smtp.resend.com
SMTP_USER=resend
SMTP_PASS=re_SWrq4QUt_9qbwmnBGxRbZdsBWA3wwi8Fr
SMTP_PORT=587
SMTP_ADMIN_EMAIL=admin@realestate.com
SMTP_SENDER_NAME=Realestate platform

# Supabase Auth — Captcha (production only, set via `supabase secrets set` or Supabase dashboard)
SUPABASE_AUTH_CAPTCHA_SECRET=0x4AAAAAADxiZvuAo_h_cvqDuV_92Q2eio8

# Supabase Auth — OAuth SSO
# Google: create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=474593028846-mdvmcnsc5iis5rr9csaf7h3ht17rnjev.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=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
# Apple: requires Apple Developer account ($99/yr). Create a Service ID at https://developer.apple.com
#SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
#SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# Telegram Bot (for Telegram OTP — create a bot via https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
# Scale-ready: comma-separated nodes + pool tuning (no code change to add nodes).
# ELASTICSEARCH_URLS=http://es01:9200,http://es02:9200
# ES_SNIFF_ON_START=0
# ES_REQUEST_TIMEOUT_MS=5000
# ES_MAX_RETRIES=3
# Index scale (used by scripts/es-indexer.js + es-project-indexer.js):
# ES_SHARDS=1
# ES_REPLICAS=1

# Redis
REDIS_URL=redis://localhost:6379
# Scale-ready: REDIS_CLUSTER=1 + comma REDIS_URL to add nodes; singleflight on.
# REDIS_CLUSTER=0
# DIST_SINGLEFLIGHT=1

# Scale-ready tile caps (bounded per-query fan-out as ES shards grow):
# TILE_MAX_ATTEMPTS=2
# TILE_SHARD_SIZE=1500
# TILE_MAX_PRECISION_LOW_ZOOM=6
# TILE_MAX_TILES=8
# TILE_CONCURRENCY=6
# LAZY_PILLS=1
# GEO_ROUTING=1

# Map (Get key from https://cloud.maptiler.com)
NEXT_PUBLIC_MAPTILER_KEY=TrCfekmv7jylPSiqmMwc

# Tenant / white-label (one deployment per buyer; see tenants/*.json)
# Copy tenants/default.json to tenants/<slug>.json and set NEXT_PUBLIC_TENANT
# to launch a new country/brand with zero code changes.
NEXT_PUBLIC_TENANT=default
# Optional overrides (fall back to tenants/<slug>.json when unset):
# NEXT_PUBLIC_BRAND_NAME="Soft Homes"
# NEXT_PUBLIC_LOCALE=en-IN
# NEXT_PUBLIC_CURRENCY=INR
# NEXT_PUBLIC_PROPERTY_CURRENCY=INR
# NEXT_PUBLIC_PROJECT_CURRENCY=AED
# NEXT_PUBLIC_MAP_CENTER=77.0266,28.4595
# NEXT_PUBLIC_MAP_ZOOM=4
# NEXT_PUBLIC_GEOCODE_COUNTRIES=

# AI Chatbot (Python backend)
# Providers: groq | openai | deepseek | mimo | openrouter
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0

# Groq (default)
GROQ_API_KEY=your-groq-key

# OpenAI
OPENAI_API_KEY=your-openai-key

# DeepSeek V4 Flash
DEEPSEEK_API_KEY=your-deepseek-key

# MiMo V2.5
MIMO_API_KEY=your-mimo-key
MIMO_BASE_URL=https://platform.xiaomimimo.com/v1

# OpenRouter (one key for 342+ models including free ones)
# Model format: provider/model (e.g., deepseek/deepseek-v4-flash:free)
OPENROUTER_API_KEY=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
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

TAVILY_API_KEY=your-tavily-key
NEXT_PUBLIC_CHAT_API_URL=http://localhost:8000
