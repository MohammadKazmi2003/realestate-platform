# Required keys — console.groq.com, tavily.com, maptiler.com
GROQ_API_KEY=paste-your-groq-key-here
TAVILY_API_KEY=paste-your-tavily-key-here
NEXT_PUBLIC_MAPTILER_KEY=paste-your-maptiler-key-here
